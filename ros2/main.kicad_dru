(version 1)

# KiCad custom design rules for isolation-milled PCBs on a Makera Carvera Air.
# Conservative starting values: not published by Makera. Cut a test coupon and adjust to your bit.
# No plating, solder mask or silkscreen is assumed.
# Copy this file next to your project and name it <project>.kicad_dru.
# When several rules match, the later one wins.

(rule "copper clearance"
  # Must exceed the width the V-bit cuts: tip + 2 * depth * tan(angle / 2).
  # Track-track, track-via, via-via: 0.85 mm minimum, routed at 0.9 mm (user requirement).
  (constraint clearance (min 0.85mm) (opt 0.9mm)))

(rule "track width"
  # 1.0 mm preferred, 0.8 mm normal minimum; thinner only where nothing else fits.
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.4mm) (opt 1.0mm)))

(rule "through-hole pad ring"
  # Unplated copper has to survive drilling and soldering.
  (condition "A.Type == 'pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.45mm)))

(rule "smallest drill"
  # Set this to the smallest drill you own.
  (constraint hole_size (min 0.8mm)))

(rule "vias"
  # Sized for a soldered wire link. Change them to fit if you use rivets.
  (condition "A.Type == 'via'")
  (constraint hole_size (min 0.8mm))
  (constraint via_diameter (min 1.8mm)))

(rule "copper to board edge"
  (constraint edge_clearance (min 0.6mm)))

(rule "copper pours"
  (condition "A.Type == 'zone'")
  (constraint clearance (min 0.9mm))
  (constraint thermal_relief_gap (min 1.0mm))
  (constraint thermal_spoke_width (min 0.8mm)))

(rule "pad clearance"
  # 1.0 mm from every pad to tracks, vias and pours (user requirement).
  (condition "A.Type == 'pad' || B.Type == 'pad'")
  (constraint clearance (min 1.0mm)))

(rule "pad to pad"
  # Footprints are fixed: 2.54 mm headers with 1.9-2.0 mm pads leave ~0.54 mm.
  # Only pad-to-pad gaps are exempt. Must stay the last clearance rule.
  (condition "A.Type == 'pad' && B.Type == 'pad'")
  (constraint clearance (min 0.5mm)))
